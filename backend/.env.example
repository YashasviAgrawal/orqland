# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orqland_om

# HTTP
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth — the standalone module issues its own JWTs for the demo.
# In production Orqland's identity provider signs the tokens; see docs/INTEGRATION_GUIDE.md
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Sample payment provider webhook secret (payment gateway integration is out of scope)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Enables /api/v1/simulator/* (customer-side sample API used by the demo). Disable in production.
ENABLE_SIMULATOR=true
# Enables /api/v1/auth/demo-login. Disable in production.
ENABLE_DEMO_LOGIN=true

# Background job interval for expiring unaccepted delivery offers (ms)
ASSIGNMENT_EXPIRY_SWEEP_MS=15000
