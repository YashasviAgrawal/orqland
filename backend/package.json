{
  "name": "@orqland/order-management-api",
  "version": "1.0.0",
  "description": "Orqland Order Management module \u2014 NestJS + PostgreSQL API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrate": "ts-node -T src/cli/migrate.ts",
    "db:seed": "ts-node -T src/cli/seed.ts",
    "db:reset": "ts-node -T src/cli/migrate.ts --reset && ts-node -T src/cli/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test test/domain.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/services.e2e.test.ts",
    "docs:actions": "tsx scripts/print-action-matrix.ts > ../docs/ACTION_MATRIX.md",
    "db:migrate:prod": "node dist/cli/migrate.js",
    "db:seed:prod": "node dist/cli/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
